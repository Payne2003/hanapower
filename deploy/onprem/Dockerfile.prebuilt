# Đóng gói bản build có sẵn (chạy trước: BUILD_STANDALONE=1 npm run build trên máy build/CI).
# Dùng khi máy chủ văn phòng không có Internet để chạy `npm ci` trong Docker.
#   docker build -f deploy/onprem/Dockerfile.prebuilt -t hanapower-app:local .
ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S app && adduser -S app -G app
COPY --chown=app:app .next/standalone ./
COPY --chown=app:app .next/static ./.next/static
COPY --chown=app:app public ./public
USER app
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1:3000/dang-nhap >/dev/null || exit 1
CMD ["node", "server.js"]
