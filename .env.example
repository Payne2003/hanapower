# =====================================================================
# Cấu hình môi trường — sao chép thành .env.local (phát triển) rồi điền giá trị.
# PowerShell: scripts\setup.ps1 tự tạo .env.local từ Supabase CLI.
# Mọi biến đọc LÚC CHẠY (runtime): một bản build dùng cho cả cloud và tại văn phòng.
# =====================================================================

# Địa chỉ Supabase mà TRÌNH DUYỆT dùng.
#   Phát triển (Supabase CLI):  http://127.0.0.1:54321
#   Cloud:                      https://<project-ref>.supabase.co
#   Tại văn phòng (gateway):    https://hanapower.lan   (cùng địa chỉ với ứng dụng)
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321

# (Tùy chọn) Địa chỉ Supabase mà MÁY CHỦ Next.js dùng, nếu khác địa chỉ công khai
# (vd. mạng nội bộ Docker: http://gateway:8000). Để trống = dùng SUPABASE_PUBLIC_URL.
SUPABASE_INTERNAL_URL=

# Khóa công khai (anon). An toàn để gửi tới trình duyệt — quyền thật do RLS quyết định.
SUPABASE_ANON_KEY=

# Khóa service_role — CHỈ ở máy chủ, KHÔNG BAO GIỜ đưa vào mã phía trình duyệt / commit.
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi kết nối Postgres cho migration/seed/kiểm thử CSDL (không dùng trong ứng dụng web).
#   Supabase CLI: postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Múi giờ doanh nghiệp được chốt trong CSDL (bảng organizations.timezone, mặc định Asia/Ho_Chi_Minh).
# Biến này chỉ để tham khảo cho công cụ triển khai.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# development | production — production chặn lệnh xóa CSDL (db:reset).
APP_ENV=development
