{
  "name": "hanapower",
  "version": "0.3.1",
  "private": true,
  "description": "Ứng dụng quản trị công việc nội bộ (giao việc, báo cáo, tiến độ, chat) - Next.js + Supabase",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:db": "node scripts/migrate.mjs --reset --yes --seed && vitest run tests/db",
    "test:e2e": "playwright test --trace off",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/migrate.mjs --seed-only",
    "db:reset": "node scripts/migrate.mjs --reset --seed",
    "test:all": "npm run test && npm run test:db && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.80.0",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
